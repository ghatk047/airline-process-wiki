flowchart TB

  subgraph SOURCES["📡 Data Sources — All Domains"]
    direction LR
    PSS4["Amadeus Altéa PSS\nBookings · PNRs · Revenue"]
    OPS4["Ops Systems\nScout NOC · Crew · MRO"]
    GDS4["GDS / NDC\nSearch · Booking events"]
    LOYALTY4["Loyalty Platform\nMember · Miles · Spend"]
    ERP4["SAP S/4HANA\nFinance · HR · Procurement"]
  end

  subgraph INGEST["⚙️ Ingestion & Integration"]
    direction LR
    GLUE2["AWS Glue\nETL · Data catalogue"]
    KAFKA["Confluent Kafka\nReal-time event streaming"]
    FIREHOSE["Kinesis Firehose\nStream to S3"]
    PSS4 -->|"batch & CDC"| GLUE2
    OPS4 -->|"real-time events"| KAFKA
    GDS4 -->|"clickstream"| KAFKA
    LOYALTY4 -->|"activity events"| KAFKA
    ERP4 -->|"daily extract"| GLUE2
    KAFKA -->|"stream"| FIREHOSE
  end

  subgraph LAKE["🗄️ Data Lake & Warehouse"]
    direction TB
    S3["AWS S3\nRaw · Curated · Archived zones"]
    REDSHIFT2["AWS Redshift\nEnterprise data warehouse"]
    GLUE2 -->|"transformed"| S3
    FIREHOSE -->|"streamed"| S3
    S3 -->|"curated data"| REDSHIFT2
  end

  subgraph AI["🤖 AI / ML Platform"]
    direction TB
    SAGEMAKER["AWS SageMaker\nModel training · Feature store"]
    CAIRO3["Cairo AI\nCancellation optimiser"]
    DEMAND2["Demand Forecast\nSkyCAST ML · O&D model"]
    FRAUD["Fraud Detection\nTransaction scoring"]
    S3 -->|"training data"| SAGEMAKER
    SAGEMAKER -->|"models"| CAIRO3
    SAGEMAKER -->|"models"| DEMAND2
    SAGEMAKER -->|"models"| FRAUD
  end

  subgraph SERVE["📤 Model Serving & Consumption"]
    direction LR
    REALTIME["Real-Time APIs\nOffer pricing · Disruption alert"]
    BATCH["Batch Scoring\nDemand forecast · Churn"]
    CAIRO3 -->|"cancel decision"| REALTIME
    DEMAND2 -->|"forecast"| BATCH
    FRAUD -->|"risk score"| REALTIME
  end

  subgraph ANALYTICS["📊 Analytics & BI"]
    direction LR
    TABLEAU3["Tableau\nOps · Commercial · Finance"]
    POWERBI2["Power BI\nExecutive dashboards"]
    REDSHIFT2 -->|"data"| TABLEAU3
    REDSHIFT2 -->|"data"| POWERBI2
    BATCH -->|"scored data"| REDSHIFT2
  end

  REALTIME -->|"live data"| KAFKA

