    OAG["OAG Schedule Analyser\nCompetitor capacity · Market share"]
    SABRE_CI["Sabre PRISM\nCompetitor fare monitoring"]
    ATPCO2["ATPCO\nFare filing · Rules · Taxes"]
  end

