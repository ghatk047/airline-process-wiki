    NRM2 -->|"availability controls"| NDC2
  end

  subgraph SETTLE["🏦 Settlement & Accounting"]
    direction TB
    BSP["IATA BSP\nTravel agency settlement"]
    ARC["ARC\nUS domestic reporting"]
    SAP["SAP S/4HANA\nRevenue accounting · GL"]
    ALTEA2 -->|"ticket coupons"| BSP
    ALTEA2 -->|"ticket coupons"| ARC
    BSP -->|"settlement files"| SAP
    ARC -->|"billing data"| SAP
  end

  subgraph REPORT["📊 Performance Reporting"]
    direction TB
    DW2["AWS Redshift\nRevenue data warehouse"]
    TABLEAU2["Tableau\nRASK · CASK · Load factor"]
    SAP -->|"actuals"| DW2
    ALTEA2 -->|"booking data"| DW2
    DW2 -->|"dashboards"| TABLEAU2
  end

