    NRM2 -->|"booking limits"| OVERBK
  end

  subgraph PSS2["🎟️ PSS & Inventory"]
    direction TB
    ALTEA2["Amadeus Altéa PSS\nInventory · Bookings · Ticketing"]
    NDC2["NDC API Gateway\nOffer creation · Ancillary"]
