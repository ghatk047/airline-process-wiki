%%{init: {'theme':'base','themeVariables':{'fontSize':'12px','fontFamily':'Inter, Arial'}}}%%
flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1{"Risk Assessment Review<br/>Risk Analyst"}
    N2{"Insurance Policy Review<br/>Finance Analyst"}
    N3{"Budget Allocation for Insurance<br/>Treasury Manager"}
    N4{"Vendor Selection for Insurance Providers<br/>Procurement Manager"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Negotiation of Insurance Terms<br/>Finance Analyst"]
    N6["Policy Documentation and Review<br/>Legal Counsel"]
    N7["Policy Implementation<br/>Finance Analyst"]
    N8["Policy Monitoring and Reporting<br/>Risk Analyst"]
    N9["Claim Handling and Management<br/>Claims Manager"]
    N10["Risk Mitigation Strategies Review<br/>Risk Analyst"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Policy Renewal Planning<br/>Finance Analyst"]
    N12["Budget Reallocation for Renewals<br/>Treasury Manager"]
    N13["Review and Update Insurance Policy Portfol<br/>Finance Analyst"]
    N14["Final Review and Reporting<br/>Risk Analyst"]
  end
  START --> N1
  N1 -->|Yes| N2
  N2 -->|Yes| N3
  E15["Exception Budget Allocation for Insurance"]
  N3 -.->|Exception| E15
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  E16["Exception Negotiation of Insurance Terms"]
  N5 -.->|Exception| E16
  N5 --> N6
  N6 --> N7
  N7 --> N8
  N8 --> N9
  N9 --> N10
  N10 --> N11
  N11 --> N12
  E17["Exception Budget Reallocation for Renewals"]
  N12 -.->|Exception| E17
  N12 --> N13
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N2 -.->|No| N1
  N1 -.->|No| START
  N3 -.->|No| N2
  N4 -.->|No| N3
  classDef startEnd fill:#003366,color:#fff,stroke:#003366
