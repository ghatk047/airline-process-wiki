flowchart LR
  subgraph P1[Phase 1: Budget Baseline]
    A([Start]) --> B[Extract historical MRO spend]
    B --> C[Validate cost centre structure]
    C --> D{Budget targets set?}
    D -- No --> C
    D -- Yes --> E[Approve annual MRO budget]
  end
  subgraph P2[Phase 2: Cost Capture]
    E --> F[Record work order costs in AMOS]
    F --> G[Allocate labour, materials and vendor costs]
    G --> H{Allocation complete and accurate?}
    H -- No --> G
    H -- Yes --> I[Close work order cost records]
  end
  subgraph P3[Phase 3: Invoice Validation]
    I --> J[Receive vendor invoices via SAP Ariba]
    J --> K[3-way match: PO vs GRN vs invoice]
    K --> L{Invoice within approved scope?}
    L -- No --> M[Raise dispute and hold payment]
    M --> K
    L -- Yes --> N[Post invoice in SAP S/4HANA AP]
  end
  subgraph P4[Phase 4: KPI Reporting]
    N --> O[Calculate CPFH, CPD and cost ratios]
    O --> P[Publish KPI dashboard in Power BI]
    P --> Q{KPIs within threshold?}
    Q -- No --> R[Trigger variance alert]
    Q -- Yes --> S[Distribute approved report]
  end
  subgraph P5[Variance and Corrective Action]
    R --> T[Root-cause analysis of cost overrun]
    T --> U{Material variance confirmed?}
    U -- No --> S
    U -- Yes --> V[Issue corrective action plan]
    V --> W[Update rolling forecast in SAP CO]
  end
  subgraph P6[Governance and Closure]
    S --> X[Present MRO cost report to leadership]
    W --> X
    X --> Y([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style Y fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style H fill:#ff6600,color:#fff,stroke:#ff6600
  style L fill:#ff6600,color:#fff,stroke:#ff6600
  style Q fill:#ff6600,color:#fff,stroke:#ff6600
  style U fill:#ff6600,color:#fff,stroke:#ff6600
