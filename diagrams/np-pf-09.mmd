flowchart LR
  subgraph P1["Phase 1: FX Rate Sourcing & Validation"]
    A([Start]) --> B[Ingest daily FX rate feed]
    B --> C[Cross-validate vs IATA ROEs]
    C --> D{Deviation > 1%?}
    D -- No --> E[Approve rate set for filing]
    D -- Yes --> F[Escalate to Revenue Director]
    F --> D
  end
  subgraph P2["Phase 2: IATA ROE Filing & Distribution"]
    E --> G[Submit ROE update to ATPCO]
    G --> H{ROE accepted by ATPCO?}
    H -- Yes --> I[Confirm effective date]
    H -- No --> G
    I --> J[Distribute ROEs to NDC channels]
  end
  subgraph P3["Phase 3: Fare Conversion & Publication"]
    J --> K[Recalculate local-currency fares]
    K --> L[Validate vs competitive price bands]
    L --> M{Outlier fares detected?}
    M -- No --> N[Publish fares to GDS & PSS]
    M -- Yes --> O[Override floor/ceiling fares]
    O --> N
  end
  subgraph P4["Phase 4: Revenue Accounting & Hedging"]
    N --> P[Revalue FX ticket revenue in SAP]
    P --> Q[Assess FX exposure vs hedge ratio]
    Q --> R{Hedge ratio outside 60-80%?}
    R -- No --> S[Document hedge compliance]
    R -- Yes --> T[Execute hedge adjustment]
    T --> S
  end
  subgraph P5["Phase 5: Exception Handling & Reporting"]
    S --> U[Identify out-of-rate tickets]
    U --> V{FX variance > 2%?}
    V -- No --> W[Waive or absorb variance]
    V -- Yes --> X[Issue ADM to agency]
    W --> Y[Publish FX P&L dashboard]
    X --> Y
    Y --> Z([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style Z fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style H fill:#ff6600,color:#fff,stroke:#ff6600
  style M fill:#ff6600,color:#fff,stroke:#ff6600
  style R fill:#ff6600,color:#fff,stroke:#ff6600
  style V fill:#ff6600,color:#fff,stroke:#ff6600
