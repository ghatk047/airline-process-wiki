flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1["Data Collection<br/>Financial Analyst"]
    N2{"Risk Identification<br/>Credit Risk Analyst"}
    N3{"Merchant Review<br/>Merchants Relations Manager"}
    N4["Regulatory Compliance Check<br/>Compliance Officer"]
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5{"Risk Assessment<br/>Financial Analyst"}
    N6{"Mitigation Strategy Development<br/>Risk Manager"}
    N7["Implementation Plan Creation<br/>Project Manager"]
    N8["Resource Allocation<br/>Finance Manager"]
    N9["Monitor and Adjust<br/>Financial Analyst"]
    N10["Reporting and Review<br/>Risk Manager"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Review and Approve<br/>Finance Director"]
    N12["Implementation Execution<br/>Project Manager"]
    N13["Continuous Monitoring<br/>Financial Analyst"]
    N14["Final Review and Reporting<br/>Risk Manager"]
  end
  START --> N1
  E15["Exception Data Collection"]
  N1 -.->|Exception| E15
  N1 --> N2
  N2 -->|Yes| N3
  N3 -->|Yes| N4
  E16["Exception Regulatory Compliance Check"]
  N4 -.->|Exception| E16
  N4 --> N5
  N5 -->|Yes| N6
  N6 -->|Yes| N7
  N7 --> N8
  N8 --> N9
  N9 --> N10
  E17["Exception Reporting and Review"]
  N10 -.->|Exception| E17
  N10 --> N11
  N11 --> N12
  N12 --> N13
  N13 --> N14
  E18["Exception Final Review and Reporting"]
  N14 -.->|Exception| E18
  DONE([Complete])
  N14 --> DONE
  N3 -.->|No| N2
  N2 -.->|No| N1
  N6 -.->|No| N5
  N5 -.->|No| N4
  classDef startEnd fill:#003366,color:#fff,stroke:#003366
