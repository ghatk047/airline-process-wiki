flowchart LR
  subgraph P1[Phase 1: Schedule Input and Constraint Loading]
    A([Start]) --> B[Extract flight schedule\nfrom SkyWORKS]
    B --> C[Load FAR Pt 117 and\nCBA rule set]
    C --> D{Fleet qualification\ngap detected?}
    D -- No --> E[Qualified crew pool\nper type confirmed]
    D -- Yes --> C
  end
  subgraph P2[Phase 2: Duty Period Construction]
    E --> F[Generate candidate\nduty periods]
    F --> G{Pairing violates\nFAR Pt 117 limits?}
    G -- Yes --> F
    G -- No --> H{Deadhead cost\nexceeds threshold?}
    H -- Yes --> F
    H -- No --> I[Domicile-constrained\npairing set ready]
  end
  subgraph P3[Phase 3: Optimization Run]
    I --> J[Execute IP solver\nJeppesen Pairing Opt]
    J --> K{Flights uncovered\nin solution?}
    K -- Yes --> J
    K -- No --> L{Pairing cost\n>5% over budget?}
    L -- Yes --> J
    L -- No --> M[Cost-validated\npairing plan]
  end
  subgraph P4[Phase 4: CBA Compliance Review]
    M --> N{CBA violations\ndetected?}
    N -- Yes --> O[Resolve via\nmanual edit]
    O --> N
    N -- No --> P[Approved\npairing set]
  end
  subgraph P5[Phase 5: Rostering and Bid Publication]
    P --> Q[Build roster lines\nfrom pairings]
    Q --> R[Allocate reserve\ncoverage]
    R --> S{Reserve ratio\n≥ 110%?}
    S -- No --> R
    S -- Yes --> T{Bid published\n≥21 days before?}
    T -- No --> U[Escalate to\nplanning manager]
    T -- Yes --> V[Process crew bids\nby seniority]
    V --> W[Publish rosters\nto Altéa PSS]
    W --> X([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style X fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style G fill:#ff6600,color:#fff,stroke:#ff6600
  style H fill:#ff6600,color:#fff,stroke:#ff6600
  style K fill:#ff6600,color:#fff,stroke:#ff6600
  style L fill:#ff6600,color:#fff,stroke:#ff6600
  style N fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
  style T fill:#ff6600,color:#fff,stroke:#ff6600
