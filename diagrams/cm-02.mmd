flowchart LR
  subgraph P1[Phase 1: Roster Preparation]
    A([Start]) --> B[Import approved pairings]
    B --> C[Configure bid period rules]
    C --> D{Qualifications expiring?}
    D -- Yes --> E[Flag crew for retraining]
    D -- No --> F[Publish eligible crew list]
    E --> F
  end
  subgraph P2[Phase 2: Bidding]
    F --> G[Publish bid package]
    G --> H[Capture crew bids]
    H --> I{All bids submitted?}
    I -- No --> J[Apply default bid rules]
    J --> K[Validate and close bids]
    I -- Yes --> K
  end
  subgraph P3[Phase 3: Roster Optimization]
    K --> L[Run bid award algorithm]
    L --> M{All pairings covered?}
    M -- No --> N[Assign reserve crew]
    N --> M
    M -- Yes --> O[Apply FRMS constraints]
    O --> P{Fatigue scores safe?}
    P -- No --> L
    P -- Yes --> Q[FAR Part 117 check]
    Q --> R{Violations detected?}
    R -- Yes --> L
    R -- No --> S[Draft roster complete]
  end
  subgraph P4[Phase 4: Conflict Resolution]
    S --> T{Bid protests filed?}
    T -- Yes --> U[Adjudicate protests]
    U --> T
    T -- No --> V[Apply pre-approved swaps]
  end
  subgraph P5[Phase 5: Compliance and Publication]
    V --> W{Compliance approved?}
    W -- No --> X[Resolve open violations]
    X --> W
    W -- Yes --> Y[Publish roster and notify crew]
    Y --> Z[Distribute roster to OCC]
    Z --> ZZ([End])
  end

  style A  fill:#003366,color:#fff,stroke:#003366
  style ZZ fill:#003366,color:#fff,stroke:#003366
  style D  fill:#ff6600,color:#fff,stroke:#ff6600
  style I  fill:#ff6600,color:#fff,stroke:#ff6600
  style M  fill:#ff6600,color:#fff,stroke:#ff6600
  style P  fill:#ff6600,color:#fff,stroke:#ff6600
  style R  fill:#ff6600,color:#fff,stroke:#ff6600
  style T  fill:#ff6600,color:#fff,stroke:#ff6600
  style W  fill:#ff6600,color:#fff,stroke:#ff6600
