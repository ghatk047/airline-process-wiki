flowchart LR
  subgraph P1["Phase 1: Aircraft ETOPS Qualification"]
    A([Start]) --> B[Verify ETOPS authorization]
    B --> C[Check MEL/CDL serviceability]
    C --> D{Aircraft ETOPS-eligible?}
    D -- No --> E[Raise AOG / defer flight]
    D -- Yes --> F[Record qualification]
  end
  subgraph P2["Phase 2: Route & Alternate Planning"]
    F --> G[Define ETOPS entry/exit waypoints]
    G --> H[Select adequate alternates]
    H --> I{Alternates within diversion time?}
    I -- No --> H
    I -- Yes --> J[Calculate critical fuel & ETP]
  end
  subgraph P3["Phase 3: Weather & NOTAM Assessment"]
    J --> K[Pull alternate weather TAF/METAR]
    K --> L[Assess SIGMET / PIREP track]
    L --> M{Alternates above ETOPS minima?}
    M -- No --> N[Revise alternate selection]
    N --> K
    M -- Yes --> O[Clear NOTAM review]
  end
  subgraph P4["Phase 4: Dispatch Release & Crew Auth"]
    O --> P[Issue ETOPS dispatch release]
    P --> Q{Crew ETOPS currency valid?}
    Q -- No --> R[Assign ETOPS-qualified crew]
    Q -- Yes --> S[Pre-departure ETOPS briefing]
  end
  subgraph P5["Phase 5: In-flight ETOPS Monitoring"]
    S --> T[Monitor ACARS engine health]
    T --> U[Track alternate weather updates]
    U --> V{Anomaly or alternate wx degraded?}
    V -- No --> U
    V -- Yes --> W[Execute diversion protocol]
    W --> X([Divert / Continue w/ alert])
  end
  subgraph P6["Phase 6: Post-flight Compliance"]
    X --> Y[File ETOPS completion report]
    Y --> Z[Update significant-system MX records]
    Z --> AA([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style AA fill:#003366,color:#fff,stroke:#003366
  style X fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style M fill:#ff6600,color:#fff,stroke:#ff6600
  style Q fill:#ff6600,color:#fff,stroke:#ff6600
  style V fill:#ff6600,color:#fff,stroke:#ff6600
