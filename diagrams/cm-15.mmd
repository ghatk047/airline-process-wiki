flowchart LR
  subgraph P1[Phase 1: Duty and Flight Hours Capture]
    A([Start]) --> B[Extract completed duty periods]
    B --> C[Validate block times vs ACARS]
    C --> D{Discrepancy >2 min?}
    D -- Yes --> E[Adjudicate with crew sign-off]
    E --> D
    D -- No --> F[Lock finalised duty records]
  end

  subgraph P2[Phase 2: CBA Pay Rule Application]
    F --> G[Load CBA rules for crew category]
    G --> H[Calculate block/credit hrs and per diem]
    H --> I{Min guarantee triggered?}
    I -- Yes --> J[Apply min guarantee override]
    J --> K[Apply premiums and special pay]
    I -- No --> K
  end

  subgraph P3[Phase 3: FAR Part 117 Compliance Check]
    K --> L[Validate daily FDP and rest limits]
    L --> M{Cumulative hrs limit breached?}
    M -- Yes --> N[Flag violation — escalate Crew Compliance]
    N --> O[Adjust roster and recompute hours]
    O --> M
    M -- No --> P[Approve hours for payroll submission]
  end

  subgraph P4[Phase 4: Payroll Processing and SAP Integration]
    P --> Q[Transfer pay records to SAP SuccessFactors]
    Q --> R[Run payroll calculation engine]
    R --> S{Payroll errors detected?}
    S -- Yes --> T[Correct data and resubmit]
    T --> R
    S -- No --> U[Generate pay advices and GL postings]
  end

  subgraph P5[Phase 5: Reconciliation and Audit]
    U --> V[Reconcile payroll vs crew ops cost centre]
    V --> W{Variance >0.5% of payroll?}
    W -- Yes --> X[Investigate and post correcting entry]
    X --> W
    W -- No --> Y[Generate crew hours utilisation report]
    Y --> Z[Archive records per FAA retention policy]
    Z --> AA([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style AA fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style M fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
  style W fill:#ff6600,color:#fff,stroke:#ff6600
