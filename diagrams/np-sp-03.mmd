flowchart LR
  subgraph P1["Phase 1: Data Collection & Revenue Aggregation"]
    A([Start]) --> B[Extract booking & revenue data]
    B --> C[Pull ancillary & fare-mix data]
    C --> D{Data quality acceptable?}
    D -- No --> B
    D -- Yes --> E[Validate O&D completeness]
  end
  subgraph P2["Phase 2: Cost Allocation"]
    E --> F[Allocate direct operating costs]
    F --> G[Apportion fleet ownership costs]
    G --> H[Assign airport fees & handling]
    H --> I{Cost allocation reconciled?}
    I -- No --> F
    I -- Yes --> J[Freeze route cost baseline]
  end
  subgraph P3["Phase 3: Profitability Assessment"]
    J --> K[Calculate route CASM vs RASM]
    K --> L[Benchmark vs network average]
    L --> M{Route below profit threshold?}
    M -- No --> T([Route healthy — monitor])
    M -- Yes --> N[Segment by season & day-of-week]
  end
  subgraph P4["Phase 4: Scenario Modelling"]
    N --> O[Model frequency/gauge change impact]
    O --> P[Test fare adjustment scenarios]
    P --> Q{Viable recovery path found?}
    Q -- No --> R[Evaluate seasonal suspension]
    R --> S{Suspension justified?}
    S -- Yes --> U[Flag for suspension proposal]
    S -- No --> O
    Q -- Yes --> U
  end
  subgraph P5["Phase 5: Recommendations & Governance"]
    U --> V[Prepare route P&L report]
    V --> W[Present to Network Investment Committee]
    W --> X{Committee approves action?}
    X -- No --> V
    X -- Yes --> Y[Implement approved changes]
    Y --> Z([Monitor post-action performance])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style T fill:#003366,color:#fff,stroke:#003366
  style Z fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style M fill:#ff6600,color:#fff,stroke:#ff6600
  style Q fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
  style X fill:#ff6600,color:#fff,stroke:#ff6600
