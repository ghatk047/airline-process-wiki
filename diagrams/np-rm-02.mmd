flowchart LR
  subgraph P1["Phase 1: Fare Class Structure Setup"]
    A([Start]) --> B[Define fare class hierarchy in PSS]
    B --> C[Map classes to booking codes in NRM]
    C --> D{ATPCO rules aligned?}
    D -- No --> B
    D -- Yes --> E[Publish class structure to GDS]
  end

  subgraph P2["Phase 2: Demand Forecasting & Bucket Sizing"]
    E --> F[Pull historical O&D booking data]
    F --> G[Run demand forecast per bucket]
    G --> H{Forecast variance ≤15%?}
    H -- No --> G
    H -- Yes --> I[Set initial bucket inventory levels]
  end

  subgraph P3["Phase 3: Bucket Availability Control"]
    I --> J[Configure bid price & nesting strategy]
    J --> K{Booking pace on curve?}
    K -- No --> L[Adjust bucket thresholds]
    L --> K
    K -- Yes --> M[Open/close fare classes per trigger]
  end

  subgraph P4["Phase 4: Real-Time Inventory Monitoring"]
    M --> N[Monitor real-time bookings by class]
    N --> O{Critical fill threshold hit?}
    O -- Yes --> P[Re-allocate bucket inventory]
    P --> N
    O -- No --> Q[Process group booking requests]
  end

  subgraph P5["Phase 5: Exception Handling & Override"]
    Q --> R[Review analyst exception queue]
    R --> S{Manual override warranted?}
    S -- Yes --> T[Apply manual adjustment & log]
    T --> N
    S -- No --> U[Release to automated controls]
  end

  subgraph P6["Phase 6: Performance Review & Calibration"]
    U --> V[Generate post-departure revenue report]
    V --> W[Compare actual vs forecast yield]
    W --> X{Model MASE ≤ 0.25?}
    X -- No --> Y[Recalibrate forecast parameters]
    Y --> G
    X -- Yes --> Z([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style Z fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style H fill:#ff6600,color:#fff,stroke:#ff6600
  style K fill:#ff6600,color:#fff,stroke:#ff6600
  style O fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
  style X fill:#ff6600,color:#fff,stroke:#ff6600
