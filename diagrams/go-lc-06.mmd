%%{init: {'theme':'base','themeVariables':{'fontSize':'12px','fontFamily':'Inter, Arial'}}}%%
flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1{"Receive Pushback Request<br/>Flight Dispatcher"}
    N2{"Verify Aircraft Configuration<br/>Load Controller"}
    N3{"Prepare Ground Handling Equipment<br/>Ground Handler"}
    N4{"Conduct Pre-Pushback Briefing<br/>Flight Dispatcher"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Initiate Pushback Sequence<br/>Pushback Operator"]
    N6["Monitor Pushback Progress<br/>Flight Dispatcher"]
    N7["Assist with Pushback if Required<br/>Ground Handler"]
    N8["Initiate Towing Sequence<br/>Tow Operator"]
    N9["Monitor Towing Progress<br/>Flight Dispatcher"]
    N10["Assist with Towing if Required<br/>Ground Handler"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Complete Towing Sequence<br/>Tow Operator"]
    N12["Update Pushback and Towing Logs<br/>Flight Dispatcher"]
    N13["Notify Ground Control of Completion<br/>Flight Dispatcher"]
    N14["Conduct Post-Operation Review<br/>Flight Dispatcher"]
  end
  START --> N1
  N1 -->|Yes| N2
  N2 -->|Yes| N3
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  E15["Exception Initiate Pushback Sequence"]
  N5 -.->|Exception| E15
  N5 --> N6
  N6 --> N7
  N7 --> N8
  E16["Exception Initiate Towing Sequence"]
  N8 -.->|Exception| E16
  N8 --> N9
  N9 --> N10
  N10 --> N11
  E17["Exception Complete Towing Sequence"]
  N11 -.->|Exception| E17
  N11 --> N12
  N12 --> N13
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N1 -.->|No| START
  N2 -.->|No| N1
  N3 -.->|No| N2
  N4 -.->|No| N3
  classDef startEnd fill:#003366,color:#fff,stroke:#003366
  classDef exc fill:#fee2e2,stroke:#ef4444,color:#991b1b
  class START,DONE startEnd
  class E15,E16,E17 exc
  style P1 fill:#dbeafe,stroke:#3b82f6
  style P2 fill:#fef9c3,stroke:#f59e0b
  style P3 fill:#dcfce7,stroke:#22c55e