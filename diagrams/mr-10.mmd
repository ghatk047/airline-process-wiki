flowchart LR
  subgraph P1[Phase 1: Demand Planning and Forecasting]
    A([Start]) --> B[Generate rolling parts\ndemand forecast]
    B --> C[Calculate reorder points\nand min/max stock levels]
    C --> D{Part MEL-essential\nor AOG-critical?}
    D -- Yes --> E[Classify AOG/Critical\nin AMOS]
    D -- No --> E
  end
  subgraph P2[Phase 2: Sourcing and Procurement]
    E --> F{≥2 approved vendors\navailable?}
    F -- No --> G[Identify alternate\napproved source]
    G --> H[Issue RFQ / PO\nvia SAP Ariba]
    F -- Yes --> H
    H --> I{AOG emergency\nprocurement?}
    I -- Yes --> J[Expedite PO —\nbypass standard lead time]
    I -- No --> K{Airworthiness docs\nvalid and traceable?}
    J --> K
    K -- No --> H
    K -- Yes --> L[Airworthiness docs\napproved]
  end
  subgraph P3[Phase 3: Receiving and Incoming Inspection]
    L --> M[Receive parts and\nverify vs PO]
    M --> N{Qty and P/N\nmatch PO?}
    N -- No --> O[Log discrepancy\nand return to vendor]
    O --> M
    N -- Yes --> P[Incoming quality\ninspection]
    P --> Q{Pass incoming\ninspection?}
    Q -- No --> R[Tag unserviceable\nand quarantine]
    Q -- Yes --> S[Record into\nserviceable inventory]
  end
  subgraph P4[Phase 4: Inventory Management and Storage]
    S --> T[Store per spec\nrequirements]
    T --> U{Shelf-life within\nacceptable limit?}
    U -- No --> V[Quarantine and\nescalate for disposal]
    U -- Yes --> W[Update AMOS\nbin location]
  end
  subgraph P5[Phase 5: Issue and Replenishment]
    W --> X{Part available\nin serviceable stock?}
    X -- No --> Y[Trigger AOG sourcing\nor reorder]
    X -- Yes --> Z[Issue parts vs\napproved work order]
    Y --> Z
    Z --> AA[Monitor stock vs\nreorder point → SAP Ariba]
  end
  subgraph P6[Phase 6: Surplus and Disposal]
    AA --> AB[Identify unserviceable\nand surplus parts]
    AB --> AC{Repair, vendor\nreturn, or scrap?}
    AC -- Repair --> AD[Send to repair\nshop / MRO]
    AC -- Return --> AE[Vendor return and\ncredit note]
    AC -- Scrap --> AF([End])
    AD --> AF
    AE --> AF
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style AF fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style F fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style K fill:#ff6600,color:#fff,stroke:#ff6600
  style N fill:#ff6600,color:#fff,stroke:#ff6600
  style Q fill:#ff6600,color:#fff,stroke:#ff6600
  style U fill:#ff6600,color:#fff,stroke:#ff6600
  style X fill:#ff6600,color:#fff,stroke:#ff6600
  style AC fill:#ff6600,color:#fff,stroke:#ff6600
