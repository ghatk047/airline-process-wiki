%%{init: {'theme':'base','themeVariables':{'fontSize':'12px','fontFamily':'Inter, Arial'}}}%%
flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1{"Receive Flight Plan<br/>Flight Dispatcher"}
    N2{"Review Flight Plan<br/>Navigation Specialist"}
    N3{"Identify Navigation Routes<br/>Navigation Specialist"}
    N4{"Check Weather Conditions<br/>Weather Analyst"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Validate Instrument Procedures<br/>Flight Dispatcher"]
    N6["Review Instrument Procedures<br/>Navigation Specialist"]
    N7["Update Flight Plan<br/>Flight Dispatcher"]
    N8["Notify Crew of Changes<br/>Flight Dispatcher"]
    N9["Final Review and Approval<br/>Flight Operations Manager"]
    N10["Publish Approved Procedures<br/>Flight Dispatcher"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Monitor Flight Execution<br/>Flight Dispatcher"]
    N12["Review Post-Flight Report<br/>Navigation Specialist"]
    N13["Update Navigation Database<br/>Navigation Specialist"]
    N14["Close Case<br/>Flight Dispatcher"]
  end
  START --> N1
  N1 -->|Yes| N2
  N2 -->|Yes| N3
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  E15["Exception Validate Instrument Procedures"]
  N5 -.->|Exception| E15
  N5 --> N6
  N6 --> N7
  N7 --> N8
  N8 --> N9
  E16["Exception Final Review and Approval"]
  N9 -.->|Exception| E16
  N9 --> N10
  N10 --> N11
  N11 --> N12
  N12 --> N13
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N4 -.->|No| N3
  N2 -.->|No| N1
  N3 -.->|No| N2
  N1 -.->|No| START
  classDef startEnd fill:#003366,color:#fff,stroke:#003366
  classDef exc fill:#fee2e2,stroke:#ef4444,color:#991b1b
  class START,DONE startEnd
  class E15,E16 exc
  style P1 fill:#dbeafe,stroke:#3b82f6
  style P2 fill:#fef9c3,stroke:#f59e0b
  style P3 fill:#dcfce7,stroke:#22c55e