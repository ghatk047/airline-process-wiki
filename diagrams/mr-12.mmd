flowchart LR
  subgraph P1[Phase 1: Initiation and Applicability]
    A([Start]) --> B[Receive AD/SB Notice]
    B --> C[Assess Compliance Deadline]
    C --> D{Mandatory AD/EAD?}
    D -- Yes --> E[Expedite Track]
    D -- No --> F[Standard Track]
  end
  subgraph P2[Phase 2: Engineering Authorization]
    E & F --> G[Develop Engineering Order]
    G --> H{DER Approval Required?}
    H -- Yes --> I[Submit to DER/DAR]
    I --> J[CAMO EO Approval]
    H -- No --> J
  end
  subgraph P3[Phase 3: Parts and Resource Planning]
    J --> K[Raise Parts Requisition]
    K --> L{Parts Available and Serviceable?}
    L -- No --> K
    L -- Yes --> M[Reserve Slot and Tooling]
  end
  subgraph P4[Phase 4: Modification Execution]
    M --> N[Remove LRU and Prep Bay]
    N --> O[Install Avionics Mod per EO]
    O --> P{Wiring and Bonding Check?}
    P -- Fail --> O
    P -- Pass --> Q[Software Load and Config]
  end
  subgraph P5[Phase 5: Testing and Verification]
    Q --> R[Functional Ground Test]
    R --> S{All Test Params OK?}
    S -- Fail --> T[Raise Discrepancy / Rework]
    T --> O
    S -- Pass --> U[QA Final Inspection]
  end
  subgraph P6[Phase 6: Release and Records]
    U --> V[Complete Maint Release Docs]
    V --> W[Update Config Records in CAMP]
    W --> X([Aircraft Returned to Service])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style X fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style H fill:#ff6600,color:#fff,stroke:#ff6600
  style L fill:#ff6600,color:#fff,stroke:#ff6600
  style P fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
