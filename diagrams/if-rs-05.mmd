%%{init: {'theme':'base','themeVariables':{'fontSize':'12px','fontFamily':'Inter, Arial'}}}%%
flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1{"Pre-flight POS Setup<br/>Flight Dispatcher"}
    N2{"In-flight Sales Monitoring<br/>Cabin Crew"}
    N3{"Post-flight Data Upload<br/>Revenue Analyst"}
    N4{"In-flight Inventory Check<br/>Load Controller"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Sales Transaction Processing<br/>Cabin Crew"]
    N6["Refund Request Handling<br/>Cabin Crew"]
    N7["In-flight Customer Feedback Collection<br/>Cabin Crew"]
    N8["In-flight Inventory Adjustment<br/>Load Controller"]
    N9["Post-flight Inventory Reconciliation<br/>Load Controller"]
    N10["In-flight Sales Analysis<br/>Revenue Analyst"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Post-flight Data Validation<br/>Revenue Analyst"]
    N12["Customer Feedback Response<br/>Cabin Crew"]
    N13["In-flight POS System Maintenance<br/>IT Support Engineer"]
    N14["In-flight Sales Performance Review<br/>Revenue Analyst"]
  end
  START --> N1
  N1 -->|Yes| N2
  N2 -->|Yes| N3
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  E15["Exception Sales Transaction Processing"]
  N5 -.->|Exception| E15
  N5 --> N6
  E16["Exception Refund Request Handling"]
  N6 -.->|Exception| E16
  N6 --> N7
  N7 --> N8
  N8 --> N9
  N9 --> N10
  N10 --> N11
  N11 --> N12
  N12 --> N13
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N3 -.->|No| N2
  N1 -.->|No| START
  N4 -.->|No| N3
  N2 -.->|No| N1
  classDef startEnd fill:#003366,color:#fff,stroke:#003366
  classDef exc fill:#fee2e2,stroke:#ef4444,color:#991b1b
  class START,DONE startEnd
  class E15,E16 exc
  style P1 fill:#dbeafe,stroke:#3b82f6
  style P2 fill:#fef9c3,stroke:#f59e0b
  style P3 fill:#dcfce7,stroke:#22c55e