flowchart LR
  subgraph P1["Phase 1: Market Intelligence Collection"]
    A([Start]) --> B[Ingest ATPCO fare feeds]
    B --> C[Scrape OTA & metasearch fares]
    C --> D{Material fare\nchange detected?}
    D -- No --> B
    D -- Yes --> E[Tag & prioritise alert]
  end

  subgraph P2["Phase 2: Fare Analysis & Interpretation"]
    E --> F[Analyse O&D competitor\nfare positioning]
    F --> G[Assess demand\nforecast impact]
    G --> H{Response\nurgency: High?}
    H -- No --> I[Queue for\nscheduled review]
    H -- Yes --> J[Escalate to\nRM Analyst]
  end

  subgraph P3["Phase 3: Response Strategy Formulation"]
    J --> K[Evaluate inventory\navailability & load factor]
    K --> L[Model fare response\nscenarios in NRM]
    L --> M{Strategy\napproved?}
    M -- No --> L
    M -- Yes --> N[Document approved\nresponse strategy]
  end

  subgraph P4["Phase 4: Fare Filing & Activation"]
    N --> O[File revised fares\nvia ATPCO]
    O --> P[Set fare rules,\nrestrictions & booking codes]
    P --> Q{GDS distribution\nconfirmed?}
    Q -- No --> O
    Q -- Yes --> R[Activate fares\nacross all channels]
  end

  subgraph P5["Phase 5: Post-Response Monitoring & Review"]
    R --> S[Monitor booking\nvelocity & revenue]
    S --> T{Revenue impact\non target?}
    T -- No --> L
    T -- Yes --> U[Conduct post-action\nreview & log]
    U --> V([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style V fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style H fill:#ff6600,color:#fff,stroke:#ff6600
  style M fill:#ff6600,color:#fff,stroke:#ff6600
  style Q fill:#ff6600,color:#fff,stroke:#ff6600
  style T fill:#ff6600,color:#fff,stroke:#ff6600
