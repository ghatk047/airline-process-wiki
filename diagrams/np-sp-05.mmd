flowchart LR
  subgraph P1["Phase 1: Partner Assessment"]
    A([Start]) --> B[Identify codeshare candidates]
    B --> C[Analyse O&D overlap — OAG]
    C --> D{IIA/SPA agreement in place?}
    D -- No --> E[Initiate bilateral IIA negotiation]
    E --> D
    D -- Yes --> F[Define codeshare/interline scope]
  end
  subgraph P2["Phase 2: Schedule Coordination"]
    F --> G[Request SSIM feed from partner]
    G --> H[Import schedule — SkyWORKS]
    H --> I{MCT compliant at connect points?}
    I -- No --> J[Negotiate adj via SSIM SCR]
    J --> I
    I -- Yes --> K[Confirm aligned schedule]
  end
  subgraph P3["Phase 3: Inventory & Fare Setup"]
    K --> L[Configure block-space alloc — Altéa]
    L --> M[File prorate agreements — ATPCO]
    M --> N{Fare combinability rules valid?}
    N -- No --> M
    N -- Yes --> O[Fare filing confirmed — ATPCO]
  end
  subgraph P4["Phase 4: GDS & NDC Distribution"]
    O --> P[Load codeshare designators — GDS]
    P --> Q{GDS display & booking path correct?}
    Q -- No --> P
    Q -- Yes --> R[Activate NDC API connection]
  end
  subgraph P5["Phase 5: Launch & Monitoring"]
    R --> S[Brief ops & customer service]
    S --> T[Monitor booking ramp-up — Amadeus NRM]
    T --> U{Revenue contribution on target?}
    U -- No --> V[Adjust capacity or renegotiate terms]
    V --> T
    U -- Yes --> W([Season complete])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style W fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style N fill:#ff6600,color:#fff,stroke:#ff6600
  style Q fill:#ff6600,color:#fff,stroke:#ff6600
  style U fill:#ff6600,color:#fff,stroke:#ff6600
