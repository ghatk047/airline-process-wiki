flowchart LR
  subgraph P1["Phase 1: Competitive Data Ingestion"]
    A([Start]) --> B[Extract OAG schedule feed]
    B --> C[Pull DOT Form 41 traffic data]
    C --> D{Data complete\nand current?}
    D -- No --> B
    D -- Yes --> E[Load to Redshift data lake]
  end
  subgraph P2["Phase 2: Schedule & Frequency Analysis"]
    E --> F[Map competitor frequency\nby route & time-of-day]
    F --> G[Identify schedule gaps\nand overlap windows]
    G --> H{Material competitive\nthreat detected?}
    H -- No --> I[Log findings, no action]
    H -- Yes --> J[Flag routes for\ncapacity modelling]
  end
  subgraph P3["Phase 3: Capacity Benchmarking"]
    J --> K[Compute ASM/RPM trends\nvs industry peers]
    K --> L[Benchmark CASK & RASK\nagainst DOT Form 41]
    L --> M{Own metrics below\nbenchmark threshold?}
    M -- No --> N[Document baseline,\nschedule quarterly review]
    M -- Yes --> O[Escalate to Network\nPlanning leadership]
  end
  subgraph P4["Phase 4: Market Share Analysis"]
    O --> P[Run O&D traffic share\nanalysis in SkyCAST]
    P --> Q[Model revenue impact\nof competitor capacity moves]
    Q --> R{Schedule response\njustified by model?}
    R -- No --> N
    R -- Yes --> S[Draft capacity response\nrecommendations]
  end
  subgraph P5["Phase 5: Validation & Action"]
    S --> T[Cross-validate with\nAmadeus NRM inventory]
    T --> U{RM alignment\non response?}
    U -- No --> S
    U -- Yes --> V[Submit approved changes\nto schedule planning queue]
    V --> W([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style W fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style H fill:#ff6600,color:#fff,stroke:#ff6600
  style M fill:#ff6600,color:#fff,stroke:#ff6600
  style R fill:#ff6600,color:#fff,stroke:#ff6600
  style U fill:#ff6600,color:#fff,stroke:#ff6600
