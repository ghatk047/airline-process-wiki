%%{init: {'theme':'base','themeVariables':{'fontSize':'12px','fontFamily':'Inter, Arial'}}}%%
flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1{"Report Incident<br/>Cabin Crew, Flight Dispatcher"}
    N2{"Notify Safety Officer<br/>Flight Dispatcher, Safety Officer"}
    N3{"Gather Flight Data<br/>Flight Dispatcher, Data Analyst"}
    N4{"Review Flight Logs<br/>Flight Dispatcher, Data Analyst"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Conduct Initial Assessment<br/>Safety Officer, Human Factors Specialist"]
    N6["Identify Contributing Factors<br/>Safety Officer, Human Factors Specialist"]
    N7["Analyze Crew Performance<br/>Human Factors Specialist, Flight Dispatche"]
    N8["Review Regulatory Requirements<br/>Compliance Officer, Safety Officer"]
    N9["Develop Corrective Actions<br/>Safety Officer, Compliance Officer"]
    N10["Update Training Programs<br/>Training Manager, Human Factors Specialist"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Review Final Analysis Report<br/>Safety Officer, Compliance Officer"]
    N12["Approve and Distribute Report<br/>Safety Officer, Compliance Officer"]
    N13["Monitor Implementation<br/>Training Manager, Flight Dispatcher"]
    N14["Review and Update Policies<br/>Safety Officer, Compliance Officer"]
  end
  START --> N1
  N1 -->|Yes| N2
  N2 -->|Yes| N3
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  N5 --> N6
  N6 --> N7
  N7 --> N8
  N8 --> N9
  N9 --> N10
  N10 --> N11
  N11 --> N12
  N12 --> N13
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N3 -.->|No| N2
  N1 -.->|No| START
  N4 -.->|No| N3
  N2 -.->|No| N1
  classDef startEnd fill:#003366,color:#fff,stroke:#003366
  classDef exc fill:#fee2e2,stroke:#ef4444,color:#991b1b
  class START,DONE startEnd
  style P1 fill:#dbeafe,stroke:#3b82f6
  style P2 fill:#fef9c3,stroke:#f59e0b
  style P3 fill:#dcfce7,stroke:#22c55e