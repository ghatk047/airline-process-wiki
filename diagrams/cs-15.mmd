flowchart LR
  subgraph P1[Phase 1: Regulatory Monitoring]
    A([Start]) --> B[Subscribe to FAA\nrulemaking notices]
    B --> C[Classify change\nby impact area]
    C --> D{Material impact\non AOC/OpSpecs?}
    D -- No --> B
    D -- Yes --> E[Assign regulatory\nchange owner]
  end

  subgraph P2[Phase 2: Compliance Gap Assessment]
    E --> F[Run OpSpecs\ngap analysis]
    F --> G[Review fleet type\nratings and training]
    G --> H{Non-compliance\nor gap found?}
    H -- No --> I[Document clear\ncompliance status]
    H -- Yes --> J[Raise corrective\naction plan]
    J --> K{CAP approved\nby VP Safety?}
    K -- No --> J
    K -- Yes --> L[Log CAP in ARMS]
  end

  subgraph P3[Phase 3: AOC and OpSpecs Amendment]
    L --> M[Prepare FAA\namendment package]
    I --> M
    M --> N[Submit via\nWebOPSS portal]
    N --> O{FAA requests\nadditional data?}
    O -- Yes --> P[Respond to\nFAA queries]
    P --> O
    O -- No --> Q[File approved\nOpSpecs revision]
  end

  subgraph P4[Phase 4: SMS Audit and Safety Data]
    Q --> R[Conduct SMS\ncompliance audit]
    R --> S[Analyse FOQA\nsafety indicators]
    S --> T{SPI threshold\nbreached?}
    T -- Yes --> U[File ASAP voluntary\ndisclosure report]
    T -- No --> V[Update SMS\ndashboard]
    U --> V
  end

  subgraph P5[Phase 5: Certification Maintenance]
    V --> W[Update MEL and\nOps Manual]
    W --> X[Track compliance\ncosts in SAP FI]
    X --> Y[Archive records\nand close cycle]
    Y --> Z([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style Z fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style H fill:#ff6600,color:#fff,stroke:#ff6600
  style K fill:#ff6600,color:#fff,stroke:#ff6600
  style O fill:#ff6600,color:#fff,stroke:#ff6600
  style T fill:#ff6600,color:#fff,stroke:#ff6600
