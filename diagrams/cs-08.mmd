flowchart LR
  subgraph P1[Phase 1: Platform Monitoring]
    A([Start]) --> B[Monitor Altéa availability]
    B --> C[Daily module health checks]
    C --> D{Capacity uplift needed?}
    D -- No --> E[Continue monitoring]
    D -- Yes --> F[Request Amadeus capacity uplift]
    F --> E
  end
  subgraph P2[Phase 2: Change and Release]
    E --> G[Log change request — ServiceNow]
    G --> H[Impact assessment — all modules]
    H --> I{CAB approved?}
    I -- No --> G
    I -- Yes --> J[Deploy to production]
    J --> K{Validation passed?}
    K -- No --> L[Execute rollback]
    L --> G
    K -- Yes --> M[Close CR in ServiceNow]
  end
  subgraph P3[Phase 3: Incident Management]
    M --> N[Detect PSS degradation — Datadog]
    N --> O{P1/P2 severity declared?}
    O -- No --> P[Standard incident resolution]
    O -- Yes --> Q[Engage Amadeus P1 bridge]
    Q --> R[Activate CUTE failover / workaround]
    R --> S{Operations restored?}
    S -- No --> Q
    S -- Yes --> T[Post-incident RCA — ServiceNow]
  end
  subgraph P4[Phase 4: Integration and APIS Compliance]
    T --> U[Monitor GDS / NDC API health]
    U --> V{APIS submission errors?}
    V -- No --> W[Maintain CUTE/DCS integration]
    V -- Yes --> X[Resolve APIS errors before departure]
    X --> W
  end
  subgraph P5[Phase 5: Security and Access Governance]
    W --> Y[PCI-DSS scope review — Qualys]
    Y --> Z{Compliance gap identified?}
    Z -- Yes --> AA[Remediate and retest controls]
    AA --> Z
    Z -- No --> AB[Access recertification — Okta]
    AB --> AC([Complete])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style AC fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style K fill:#ff6600,color:#fff,stroke:#ff6600
  style O fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
  style V fill:#ff6600,color:#fff,stroke:#ff6600
  style Z fill:#ff6600,color:#fff,stroke:#ff6600
