flowchart LR
  subgraph P1["Phase 1: Data Ingestion & Monitoring"]
    A([Start]) --> B[Ingest METAR/TAF feeds]
    B --> C[Ingest SIGMET/AIRMET & convective]
    C --> D{Data current & complete?}
    D -- No --> B
    D -- Yes --> E
  end
  subgraph P2["Phase 2: Threat Assessment"]
    E[Analyse route weather hazards] --> F[Assess airport conditions]
    F --> G{Threat exceeds ops limits?}
    G -- Yes --> F2[Flag route — reroute or hold]
    F2 --> H
    G -- No --> H
  end
  subgraph P3["Phase 3: Plan & Fuel Impact"]
    H[Cross-ref threats with flight plans] --> I[Calculate fuel deviation impact]
    I --> J{Alternate weather acceptable?}
    J -- No --> I
    J -- Yes --> K
  end
  subgraph P4["Phase 4: Dispatch Decision"]
    K[Issue or withhold dispatch release] --> L[Brief crew via EFB & ACARS]
    L --> M{Crew accepts release?}
    M -- No --> K
    M -- Yes --> N
  end
  subgraph P5["Phase 5: En-Route Monitoring"]
    N[Monitor en-route convective activity] --> O{Diversion required?}
    O -- No --> N
    O -- Yes --> P[Issue amended release & ATC coord]
    P --> Q([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style Q fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style G fill:#ff6600,color:#fff,stroke:#ff6600
  style J fill:#ff6600,color:#fff,stroke:#ff6600
  style M fill:#ff6600,color:#fff,stroke:#ff6600
  style O fill:#ff6600,color:#fff,stroke:#ff6600
