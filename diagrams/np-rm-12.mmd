flowchart LR
  subgraph P1["Phase 1: Inventory Initialization"]
    A([Start]) --> B[Load fleet capacity & auth limits]
    B --> C[Initialize fare class buckets]
    C --> D{Overbooking factor valid?}
    D -- No --> C
    D -- Yes --> E[Publish baseline availability]
  end
  subgraph P2["Phase 2: Booking Velocity Monitoring"]
    E --> F[Monitor booking pace vs forecast]
    F --> G{Pace deviation > threshold?}
    G -- No --> F
    G -- Yes --> H[Flag flight for availability review]
  end
  subgraph P3["Phase 3: Availability Control"]
    H --> I[Generate availability adjustment rec]
    I --> J{Within RM policy bounds?}
    J -- No --> K[Analyst manual override]
    K --> L[Open/close booking class buckets]
    J -- Yes --> L
    L --> M[Broadcast updates to GDS & NDC]
    M --> G
  end
  subgraph P4["Phase 4: Group & Allotment Mgmt"]
    M --> N[Receive group booking request]
    N --> O{Request within allotment limit?}
    O -- No --> P[Negotiate reduced block or waitlist]
    P --> O
    O -- Yes --> Q[Confirm group allocation & block seats]
  end
  subgraph P5["Phase 5: Pre-Departure Finalization"]
    Q --> R[T-72h inventory position review]
    R --> S{Unsold inventory > threshold?}
    S -- Yes --> T[Open lower classes & clear waitlist]
    T --> S
    S -- No --> U[Freeze availability at check-in cutoff]
    U --> V([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style V fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style G fill:#ff6600,color:#fff,stroke:#ff6600
  style J fill:#ff6600,color:#fff,stroke:#ff6600
  style O fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
