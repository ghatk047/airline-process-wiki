flowchart LR
  subgraph P1[Phase 1: Training Needs and Regulatory Planning]
    A([Start]) --> B[Identify expiring certs]
    B --> C{Regulatory gap\ndetected?}
    C -- No --> B
    C -- Yes --> D[Map FAR/AQP requirements]
  end
  subgraph P2[Phase 2: Scheduling and Resource Allocation]
    D --> E[Generate training schedule]
    E --> F{Crew scheduling\nconflict?}
    F -- Yes --> E
    F -- No --> G[Reserve simulator and instructor]
  end
  subgraph P3[Phase 3: Training Delivery]
    G --> H[Deliver CBT / ground school]
    H --> I[Execute simulator session]
    I --> J{Attendance\ncomplete?}
    J -- No --> H
    J -- Yes --> K[Record training completion]
  end
  subgraph P4[Phase 4: Assessment and Certification]
    K --> L[Administer written/oral exam]
    L --> M{Exam\npassed?}
    M -- No --> N[Assign remedial training]
    N --> H
    M -- Yes --> O[Conduct checkride evaluation]
    O --> P{Checkride\npassed?}
    P -- No --> N
    P -- Yes --> Q[Issue/renew certificate]
  end
  subgraph P5[Phase 5: Record Update and Sync]
    Q --> R[Update qualification records]
    R --> S{Records synced\nto scheduling?}
    S -- No --> R
    S -- Yes --> T[Publish compliance report]
  end
  subgraph P6[Phase 6: Recurrency Monitoring]
    T --> U[Monitor upcoming expiry dates]
    U --> V{Expiry within\n60 days?}
    V -- No --> U
    V -- Yes --> W[Trigger automated crew alert]
    W --> X{Crew responds\nwithin SLA?}
    X -- No --> Y[Escalate to Crew Compliance]
    X -- Yes --> E
    Y --> Z([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style Z fill:#003366,color:#fff,stroke:#003366
  style C fill:#ff6600,color:#fff,stroke:#ff6600
  style F fill:#ff6600,color:#fff,stroke:#ff6600
  style J fill:#ff6600,color:#fff,stroke:#ff6600
  style M fill:#ff6600,color:#fff,stroke:#ff6600
  style P fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
  style V fill:#ff6600,color:#fff,stroke:#ff6600
  style X fill:#ff6600,color:#fff,stroke:#ff6600
