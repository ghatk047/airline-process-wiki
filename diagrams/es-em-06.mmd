    N4{"Evaluate Project Feasibility<br/>Carbon Offset Specialist"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Select Offset Projects<br/>Sustainability Manager"]
    N6["Negotiate Project Contracts<br/>Carbon Offset Specialist"]
    N7["Monitor Project Progress<br/>Carbon Offset Specialist"]
    N8["Allocate Offset Credits<br/>Environmental Analyst"]
    N9["Report to Stakeholders<br/>Sustainability Manager"]
    N10["Review and Adjust Portfolio<br/>Sustainability Manager"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Finalize Portfolio<br/>Sustainability Manager"]
    N12["Document Compliance<br/>Environmental Analyst"]
    N13["Review and Report on Performance<br/>Sustainability Manager"]
    N14["Plan for Next Year<br/>Sustainability Manager"]
  end
  START --> N1
  N1 -->|Yes| N2
  N2 -->|Yes| N3
  E15["Exception Identify Offset Projects"]
  N3 -.->|Exception| E15
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  N5 --> N6
  E16["Exception Negotiate Project Contracts"]
  N6 -.->|Exception| E16
  N6 --> N7
  N7 --> N8
  N8 --> N9
  N9 --> N10
  N10 --> N11
  N11 --> N12
  N12 --> N13
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N3 -.->|No| N2
  N2 -.->|No| N1
  N1 -.->|No| START
  N4 -.->|No| N3
