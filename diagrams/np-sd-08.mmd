flowchart LR
  subgraph P1["Phase 1: Commission Policy Design"]
    A([Start]) --> B[Define commission\ntier structure]
    B --> C[Model financial\nimpact in Redshift]
    C --> D{Within budget\ntolerance?}
    D -- No --> B
    D -- Yes --> E[File via ATPCO\nCAT 35]
  end
  subgraph P2["Phase 2: Agency Enrollment"]
    E --> F[Validate IATA/ARC\naccreditation]
    F --> G{Accreditation\ncurrent?}
    G -- No --> F
    G -- Yes --> H[Configure GDS\ncommission profiles]
    H --> I{NDC API\ncertified?}
    I -- No --> J([Enroll later])
    I -- Yes --> K[Enroll in NDC\nincentive programme]
  end
  subgraph P3["Phase 3: Incentive Target Setting"]
    K --> L[Extract 24-month\nagency performance]
    L --> M[Set incentive\nthresholds in BI]
    M --> N{Override rate\nwithin policy?}
    N -- No --> M
    N -- Yes --> O[Approve strategic\npartner overrides]
  end
  subgraph P4["Phase 4: Performance Tracking"]
    O --> P[Ingest daily MIDT\n& NDC bookings]
    P --> Q[Calculate accruals\nin SAP FI/CO]
    Q --> R{Tier boundary\ncrossed?}
    R -- Yes --> Q
    R -- No --> S[Flag threshold\nproximity alerts]
  end
  subgraph P5["Phase 5: Settlement & Payment"]
    S --> T[Generate BSP/ARC\nbilling statement]
    T --> U{Billing matches\naccrual ±2%?}
    U -- No --> T
    U -- Yes --> V[Post AP in\nSAP S/4HANA]
    V --> W{Dispute\nclaim valid?}
    W -- Yes --> X[Issue credit note\nvia BSP Link]
    X --> V
    W -- No --> Y[Close dispute]
  end
  subgraph P6["Phase 6: Review & Optimisation"]
    Y --> Z[Analyse commission\nROI by channel]
    Z --> AA{ROI threshold\n& legal sign-off?}
    AA -- No --> Z
    AA -- Yes --> AB[Revise tier matrix\n& file ATPCO]
    AB --> AC([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style AC fill:#003366,color:#fff,stroke:#003366
  style J fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style G fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style N fill:#ff6600,color:#fff,stroke:#ff6600
  style R fill:#ff6600,color:#fff,stroke:#ff6600
  style U fill:#ff6600,color:#fff,stroke:#ff6600
  style W fill:#ff6600,color:#fff,stroke:#ff6600
  style AA fill:#ff6600,color:#fff,stroke:#ff6600
