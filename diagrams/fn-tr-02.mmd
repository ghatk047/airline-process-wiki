%%{init: {'theme':'base','themeVariables':{'fontSize':'12px','fontFamily':'Inter, Arial'}}}%%
flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1["Identify Currency Exposure<br/>Treasury Analyst"]
    N2{"Assess Market Volatility<br/>Risk Analyst"}
    N3{"Determine Risk Appetite<br/>Chief Financial Officer CFO"}
    N4{"Set Hedging Strategy<br/>Treasury Analyst"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Execute Hedging Transactions<br/>Treasury Manager"]
    N6{"Monitor Market Conditions<br/>Risk Analyst"}
    N7["Adjust Hedging Strategy<br/>Treasury Analyst"]
    N8["Review Hedging Performance<br/>Treasury Manager"]
    N9["Report to Management<br/>CFO"]
    N10["Plan Future Hedging Actions<br/>Treasury Analyst"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Review and Approve Hedging Transactions<br/>CFO"]
    N12["Update Risk Registers<br/>Risk Analyst"]
    N13["Conduct Post-Mortem Analysis<br/>Treasury Manager"]
    N14["Implement Continuous Improvement Measures<br/>Treasury Analyst"]
  end
  START --> N1
  E15["Exception Identify Currency Exposure"]
  N1 -.->|Exception| E15
  N1 --> N2
  N2 -->|Yes| N3
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  E16["Exception Execute Hedging Transactions"]
  N5 -.->|Exception| E16
  N5 --> N6
  N6 -->|Yes| N7
  N7 --> N8
  E17["Exception Review Hedging Performance"]
  N8 -.->|Exception| E17
  N8 --> N9
  N9 --> N10
  N10 --> N11
  N11 --> N12
  E18["Exception Update Risk Registers"]
  N12 -.->|Exception| E18
  N12 --> N13
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N2 -.->|No| N1
  N3 -.->|No| N2
  N4 -.->|No| N3
  N6 -.->|No| N5
  classDef startEnd fill:#003366,color:#fff,stroke:#003366
  classDef exc fill:#fee2e2,stroke:#ef4444,color:#991b1b
  class START,DONE startEnd
