  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Load Products onto Aircraft<br/>Cargo Handler"]
    N6["Configure In-Flight POS Systems<br/>In-Flight Retail Manager"]
    N7["Monitor Sales Performance<br/>Revenue Analyst"]
    N8["Adjust Promotions Based on Feedback<br/>Marketing Manager"]
    N9["Manage Returns and Exchanges<br/>Customer Service Representative"]
    N10["Update Inventory Post-Flight<br/>Load Controller"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Review BOB Program Performance<br/>Revenue Analyst"]
    N12["Update BOB Strategy Based on Performance<br/>Revenue Analyst"]
    N13["Report to Stakeholders<br/>Cabin Services Manager"]
    N14["Plan for Next Flight Cycle<br/>Revenue Analyst"]
  end
  START --> N1
  N1 -->|Yes| N2
  N2 -->|Yes| N3
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  E15["Exception Load Products onto Aircraft"]
