  N5 --> N6
  E16["Exception Configure In-Flight POS Systems"]
  N6 -.->|Exception| E16
  N6 --> N7
  E17["Exception Monitor Sales Performance"]
  N7 -.->|Exception| E17
  N7 --> N8
  N8 --> N9
  E18["Exception Manage Returns and Exchanges"]
  N9 -.->|Exception| E18
  N9 --> N10
  N10 --> N11
  N11 --> N12
  N12 --> N13
  E19["Exception Report to Stakeholders"]
  N13 -.->|Exception| E19
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N2 -.->|No| N1
  N3 -.->|No| N2
  N4 -.->|No| N3
  N1 -.->|No| START
