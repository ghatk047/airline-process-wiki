%%{init: {'theme':'base','themeVariables':{'fontSize':'12px','fontFamily':'Inter, Arial'}}}%%
flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1["Initiate Budget Cycle<br/>Finance Controller"]
    N2{"Set Budget Parameters<br/>Finance Analyst"}
    N3["Gather Financial Data<br/>Financial Analyst"]
    N4{"Forecast Revenue and Expenses<br/>Revenue Analyst, Cost Controller"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Create Initial Budget Plan<br/>Budget Planner"]
    N6{"Review and Adjust Budget Plan<br/>Finance Manager"}
    N7["Allocate Budget to Departments<br/>Budget Planner"]
    N8{"Monitor Budget Execution<br/>Financial Analyst"}
    N9["Analyze Variance<br/>Financial Analyst"]
    N10["Adjust Budget for Variance<br/>Budget Planner, Finance Manager"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Finalize Budget Plan<br/>Finance Director"]
    N12["Approve Final Budget Plan<br/>Board of Directors"]
    N13["Communicate Budget Plan<br/>Finance Director, Department Heads"]
    N14["Monitor and Report Budget Performance<br/>Financial Analyst"]
  end
  START --> N1
  N1 --> N2
  N2 -->|Yes| N3
  E15["Exception Gather Financial Data"]
  N3 -.->|Exception| E15
  N3 --> N4
  N4 -->|Yes| N5
  E16["Exception Create Initial Budget Plan"]
  N5 -.->|Exception| E16
  N5 --> N6
  N6 -->|Yes| N7
  E17["Exception Allocate Budget to Departments"]
  N7 -.->|Exception| E17
  N7 --> N8
  N8 -->|Yes| N9
  N9 --> N10
  E18["Exception Adjust Budget for Variance"]
  N10 -.->|Exception| E18
  N10 --> N11
  N11 --> N12
  N12 --> N13
  E19["Exception Communicate Budget Plan"]
  N13 -.->|Exception| E19
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N2 -.->|No| N1
  N4 -.->|No| N3
  N6 -.->|No| N5
  N8 -.->|No| N7
  classDef startEnd fill:#003366,color:#fff,stroke:#003366
  classDef exc fill:#fee2e2,stroke:#ef4444,color:#991b1b
  class START,DONE startEnd
  class E15,E16,E17,E18,E19 exc
  style P1 fill:#dbeafe,stroke:#3b82f6
  style P2 fill:#fef9c3,stroke:#f59e0b
  style P3 fill:#dcfce7,stroke:#22c55e