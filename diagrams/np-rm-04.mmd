flowchart LR
  subgraph P1["Phase 1: Data Collection & Preparation"]
    A([Start]) --> B[Extract booking & ticketing data]
    B --> C[Ingest external demand signals]
    C --> D{Data quality score ≥ 95%?}
    D -- No --> E[Cleanse & impute missing records]
    E --> D
    D -- Yes --> F[Segment data by O&D & cabin]
  end
  subgraph P2["Phase 2: Demand Unconstaining"]
    F --> G[Identify constrained observations]
    G --> H[Apply EM unconstraining algorithm]
    H --> I{Unconstraining variance ≤ 5%?}
    I -- No --> J[Adjust booking curve reference]
    J --> H
    I -- Yes --> K[Output unconstrained demand series]
  end
  subgraph P3["Phase 3: Model Calibration & Forecast Run"]
    K --> L[Select additive vs multiplicative model]
    L --> M[Apply special-event & seasonality overlays]
    M --> N[Run O&D demand forecast — SkyCAST]
    N --> O{Forecast MAPE ≤ 12%?}
    O -- No --> P[Recalibrate model coefficients]
    P --> N
    O -- Yes --> Q[Generate fare-class demand forecasts]
  end
  subgraph P4["Phase 4: Analyst Review & Approval"]
    Q --> R[Analyst reviews system forecast]
    R --> S{Manual override required?}
    S -- Yes --> T[Apply market-level adjustment]
    T --> R
    S -- No --> U[Approve & publish forecast to NRM]
  end
  subgraph P5["Phase 5: Performance Monitoring & Recalibration"]
    U --> V[Track post-departure forecast accuracy]
    V --> W{Systematic bias detected?}
    W -- No --> X([End — model stable])
    W -- Yes --> Y[Trigger model recalibration cycle]
    Y --> L
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style X fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style O fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
  style W fill:#ff6600,color:#fff,stroke:#ff6600
