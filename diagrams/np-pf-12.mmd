flowchart LR
  subgraph P1["Phase 1: RFP & Qualification"]
    A([Start]) --> B[Log RFP in\nSalesforce CRM]
    B --> C[Assess volume\n& route fit]
    C --> D{Meets volume\nthreshold?}
    D -- No --> Z1([Decline])
    D -- Yes --> E[Assign account\ntier]
  end
  subgraph P2["Phase 2: Discount Modelling"]
    E --> F[Model discount\nscenarios — SkyCAST]
    F --> G{Yield floor\npreserved on all O&Ds?}
    G -- No --> F
    G -- Yes --> H[Draft pricing\nproposal]
  end
  subgraph P3["Phase 3: Negotiation & Approval"]
    H --> I[Negotiate with\ncorporate client]
    I --> J{Counter-proposal\nwithin parameters?}
    J -- No --> I
    J -- Yes --> K[Pricing committee\napproval — DocuSign]
  end
  subgraph P4["Phase 4: Loading & Distribution"]
    K --> L[File Cat-15 fares\nin ATPCO]
    L --> M[Load fares in\nAltéa PSS]
    M --> N[Configure NDC\n& GDS channels]
    N --> O{Booking flow\nvalidated?}
    O -- Fail --> L
    O -- Pass --> P[Go-live sign-off]
  end
  subgraph P5["Phase 5: Performance Monitoring"]
    P --> Q[Monitor volume\nattainment — PRISM]
    Q --> R{Account on-track\nvs commitment?}
    R -- At-risk --> S[Intervene &\nre-engage client]
    S --> Q
    R -- On-track --> T[Process rebates\n— SAP FI/CO]
  end
  subgraph P6["Phase 6: Renewal"]
    T --> U[Annual contract\nreview — Tableau]
    U --> V{Renew or\nrenegotiate?}
    V -- Renegotiate --> H
    V -- Renew --> W([Contract renewed])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style Z1 fill:#003366,color:#fff,stroke:#003366
  style W fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style G fill:#ff6600,color:#fff,stroke:#ff6600
  style J fill:#ff6600,color:#fff,stroke:#ff6600
  style O fill:#ff6600,color:#fff,stroke:#ff6600
  style R fill:#ff6600,color:#fff,stroke:#ff6600
  style V fill:#ff6600,color:#fff,stroke:#ff6600
