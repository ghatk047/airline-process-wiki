%%{init: {'theme':'base','themeVariables':{'fontSize':'12px','fontFamily':'Inter, Arial'}}}%%
flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1{"Receive Booking Request<br/>Cargo Sales Agent"}
    N2{"Validate Booking Details<br/>Cargo Sales Agent"}
    N3{"Check Flight Availability<br/>Cargo Operations Manager"}
    N4{"Allocate Cargo Capacity<br/>Cargo Operations Manager"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Update Cargo Manifest<br/>Cargo Load Controller"]
    N6["Generate Load Plan<br/>Cargo Load Controller"]
    N7["Review Load Plan<br/>Cargo Operations Manager"]
    N8["Notify Customer of Allocation<br/>Cargo Sales Agent"]
    N9["Update Revenue System<br/>Revenue Analyst"]
    N10["Finalize Booking<br/>Cargo Sales Agent"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Monitor Cargo Loading<br/>Cargo Load Controller"]
    N12["Verify Final Manifest<br/>Cargo Operations Manager"]
    N13["Update Flight Status<br/>Flight Dispatcher"]
    N14["Close Booking Process<br/>Cargo Sales Agent"]
  end
  START --> N1
  N1 -->|Yes| N2
  N2 -->|Yes| N3
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  N5 --> N6
  N6 --> N7
  N7 --> N8
  N8 --> N9
  N9 --> N10
  N10 --> N11
  N11 --> N12
  N12 --> N13
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N4 -.->|No| N3
  N3 -.->|No| N2
  N2 -.->|No| N1
  N1 -.->|No| START
  classDef startEnd fill:#003366,color:#fff,stroke:#003366
  classDef exc fill:#fee2e2,stroke:#ef4444,color:#991b1b
  class START,DONE startEnd
  style P1 fill:#dbeafe,stroke:#3b82f6
  style P2 fill:#fef9c3,stroke:#f59e0b
  style P3 fill:#dcfce7,stroke:#22c55e