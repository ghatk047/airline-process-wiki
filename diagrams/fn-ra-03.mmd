    N8["Update Financial Records<br/>Accountant"]
    N9["Generate Settlement Reports<br/>Revenue Analyst"]
    N10["Distribute Settlement Reports<br/>Accounting Manager"]
  end
  subgraph P3["Phase 3 Close"]
