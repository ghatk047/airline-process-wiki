    N11["Monitor Payment Status<br/>Payment Specialist"]
    N12["Resolve Payment Issues<br/>Payment Specialist"]
    N13["Review Financial Statements<br/>Financial Controller"]
    N14["Close Settlement Cycle<br/>Accounting Manager"]
  end
