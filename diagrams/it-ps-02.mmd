flowchart LR
  START([Start])
  subgraph P1["Phase 1 Initiation"]
    direction TB
    N1{"System Check-In<br/>IT System Administrator"}
    N2{"Flight Data Validation<br/>Data Analyst"}
    N3{"Resource Allocation<br/>Flight Dispatcher"}
    N4{"Pre-Departure Briefing<br/>Flight Crew"}
  end
  subgraph P2["Phase 2 Execution"]
    direction TB
    N5["Boarding Gate Assignment<br/>Ground Handling Coordinator"]
    N6["Passenger Boarding Control<br/>Baggage Handler, Passenger Services Agent"]
    N7["Baggage Loading<br/>Baggage Handler"]
    N8["Security Checkpoint Management<br/>Security Officer"]
    N9["Fuel Management<br/>Flight Dispatcher, Fuel Planner"]
    N10["Final Departure Checks<br/>Flight Crew, Ground Handling Coordinator"]
  end
  subgraph P3["Phase 3 Close"]
    direction TB
    N11["Post-Departure Monitoring<br/>IT System Administrator, Flight Dispatcher"]
    N12["Passenger Feedback Collection<br/>Customer Service Representative, Passenger"]
    N13["System Maintenance Planning<br/>IT System Administrator, Maintenance Plann"]
    N14["Continuous Improvement Review<br/>IT System Administrator, Data Analyst"]
  end
  START --> N1
  N1 -->|Yes| N2
  N2 -->|Yes| N3
  N3 -->|Yes| N4
  N4 -->|Yes| N5
  N5 --> N6
  N6 --> N7
  N7 --> N8
  N8 --> N9
  N9 --> N10
  N10 --> N11
  N11 --> N12
  N12 --> N13
  N13 --> N14
  DONE([Complete])
  N14 --> DONE
  N2 -.->|No| N1
  N1 -.->|No| START
  N3 -.->|No| N2
  N4 -.->|No| N3
