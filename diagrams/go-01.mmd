flowchart LR
  subgraph P1[Phase 1: DCS Activation and APIS]
    A([Start]) --> B[Activate DCS check-in window]
    B --> C[Transmit APIS to gov gateway]
    C --> D{APIS cleared by\ncustoms authority?}
    D -- No --> C
    D -- Yes --> E[APIS clearance confirmed]
  end
  subgraph P2[Phase 2: Passenger Check-In]
    E --> F[Web/mobile self check-in]
    F --> G[Kiosk / counter check-in]
    G --> H{Identity and docs\nverified?}
    H -- No --> G
    H -- Yes --> I[Issue boarding pass]
  end
  subgraph P3[Phase 3: Baggage Acceptance]
    I --> J[Weigh and accept bags — Altéa]
    J --> K{Bag within weight\nand size limits?}
    K -- No --> L[Collect excess baggage fee]
    L --> K
    K -- Yes --> M[Tag bag — IATA 10-digit]
    M --> N[Induct bag to EDS screening]
    N --> O{Bag cleared\nby EDS/TSA?}
    O -- No --> P[Security escalation]
    P --> O
    O -- Yes --> Q[Bag inducted — confirmed]
  end
  subgraph P4[Phase 4: Gate Mgmt and Oversale]
    Q --> R[Open gate — SITA AMS]
    R --> S{Flight overbooked?\nVDB needed?}
    S -- Yes --> T[Solicit and process VDB]
    T --> S
    S -- No --> U[Assign boarding groups]
  end
  subgraph P5[Phase 5: Boarding and Closure]
    U --> V[Scan boarding passes at gate]
    V --> W{Boarding pass valid\nand authorized?}
    W -- No --> X[Resolve at gate — Altéa]
    X --> W
    W -- Yes --> Y[Final headcount reconciliation]
    Y --> Z{Pax count matches\nmanifest?}
    Z -- No --> Y
    Z -- Yes --> AA[Transmit load sheet — ACARS]
    AA --> AB([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style AB fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style H fill:#ff6600,color:#fff,stroke:#ff6600
  style K fill:#ff6600,color:#fff,stroke:#ff6600
  style O fill:#ff6600,color:#fff,stroke:#ff6600
  style S fill:#ff6600,color:#fff,stroke:#ff6600
  style W fill:#ff6600,color:#fff,stroke:#ff6600
  style Z fill:#ff6600,color:#fff,stroke:#ff6600
