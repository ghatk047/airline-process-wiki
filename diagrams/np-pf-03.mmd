flowchart LR
  subgraph P1["Phase 1: Market Opportunity Assessment"]
    A([Start]) --> B[Extract revenue shortfall\nby route & period]
    B --> C[Benchmark competitor\npromo fares via ATPCO]
    C --> D{Demand gap &\ncompetitive case valid?}
    D -- No --> E[Archive opportunity\nfor next cycle]
    D -- Yes --> F[Define target markets\n& travel windows]
  end

  subgraph P2["Phase 2: Promotional Fare Design"]
    F --> G[Model fare levels &\nadvance purchase rules]
    G --> H[Simulate revenue &\nload factor impact]
    H --> I{Projected load factor\n≥83% & rev ≥ target?}
    I -- No --> G
    I -- Yes --> J[Draft fare rules:\nmin stay, caps, blackouts]
  end

  subgraph P3["Phase 3: Approval & Compliance"]
    J --> K[Submit to Pricing\nCommittee for sign-off]
    K --> L{Fare approved by\nPricing Committee?}
    L -- No --> G
    L -- Yes --> M[Legal & DOT\ncompliance review]
    M --> N{DOT advertising\nrules compliant?}
    N -- No --> J
    N -- Yes --> O[Issue fare design\napproval record]
  end

  subgraph P4["Phase 4: ATPCO Filing & Channel Setup"]
    O --> P[File promotional fare\nrecords in ATPCO]
    P --> Q{ATPCO submission\nacknowledged & clean?}
    Q -- No --> P
    Q -- Yes --> R[Configure GDS\navailability & booking codes]
    R --> S[Publish via NDC API\nGateway & direct.com]
    S --> T{All channels priced\n& available correctly?}
    T -- No --> R
    T -- Yes --> U[Confirm channel\nactivation]
  end

  subgraph P5["Phase 5: Launch & Real-Time Monitoring"]
    U --> V[Activate promo fare\nacross all channels]
    V --> W[Monitor booking pace\n& load factor daily]
    W --> X{Booking pace below\nor above target band?}
    X -- Below --> Y[Escalate: extend sale\nor widen availability]
    X -- Above --> Z[Tighten inventory caps\nvia AltéaRM]
    Y --> W
    Z --> W
    X -- On target --> AA[Continue monitoring\nto sale close date]
  end

  subgraph P6["Phase 6: Post-Campaign Analysis"]
    AA --> AB[Pull post-campaign\nrevenue report]
    AB --> AC[Assess yield dilution\n& cannibalisation impact]
    AC --> AD{Revenue within ±5%\nof projected target?}
    AD -- No --> AE[Document variance\nfor SME review]
    AD -- Yes --> AF[Archive campaign\nbenchmarks to data lake]
    AE --> AF
    AF --> AG([End])
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style AG fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style L fill:#ff6600,color:#fff,stroke:#ff6600
  style N fill:#ff6600,color:#fff,stroke:#ff6600
  style Q fill:#ff6600,color:#fff,stroke:#ff6600
  style T fill:#ff6600,color:#fff,stroke:#ff6600
  style X fill:#ff6600,color:#fff,stroke:#ff6600
  style AD fill:#ff6600,color:#fff,stroke:#ff6600
