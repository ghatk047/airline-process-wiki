flowchart LR
  subgraph P1["Phase 1: Pre-Departure Planning & Weather"]
    A([Start]) --> B[Retrieve flight plan from NAVBLUE]
    B --> C[Pull METAR/TAF/SIGMET — GoDirect]
    C --> D{Weather acceptable\nfor dispatch?}
    D -- No --> C
    D -- Yes --> E[Calculate fuel uplift & contingency]
    E --> F{Fuel exceeds FAR 121\nminimum + policy buffer?}
    F -- No --> E
    F -- Yes --> G[Fuel uplift confirmed]
  end
  subgraph P2["Phase 2: Flight Plan Filing & ATC Slot"]
    G --> H[File IFR FPL via NAVBLUE/SITA]
    H --> I{EDCT/CTOT within\ncrew duty window?}
    I -- No --> J[Coordinate slot relief with TFMS/NMOC]
    J --> I
    I -- Yes --> K[File alternate aerodrome]
    K --> L{Suitable alternate\nwithin fuel range?}
    L -- No --> K
    L -- Yes --> M[ATC filing complete]
  end
  subgraph P3["Phase 3: Airworthiness & MEL Review"]
    M --> N[Check aircraft status — AMOS]
    N --> O{Aircraft airworthy?\nNo open ADs?}
    O -- No --> P[Escalate to Maintenance Control]
    P --> O
    O -- Yes --> Q[Review MEL/CDL — AMOS + Boeing Toolbox]
    Q --> R{All MEL items\nwithin dispatch limits?}
    R -- No --> P
    R -- Yes --> S[Verify V-speeds & performance — FliteDeck]
  end
  subgraph P4["Phase 4: Weight, Balance & Performance"]
    S --> T[Receive preliminary load sheet — Altéa]
    T --> U[Calculate TOW & CG — Altéa Load Control]
    U --> V{TOW ≤ MTOW and\nCG within envelope?}
    V -- No --> U
    V -- Yes --> W[Runway performance & obstacle check — FliteDeck]
    W --> X{Runway limits\nsatisfied?}
    X -- No --> U
    X -- Yes --> Y[Performance confirmed]
  end
  subgraph P5["Phase 5: Dispatch Release & Authorization"]
    Y --> Z[Generate OFP & Dispatch Release — NAVBLUE]
    Z --> AA[Brief Captain — ACARS/face-to-face]
    AA --> AB{Captain accepts\nrelease as issued?}
    AB -- No --> Z
    AB -- Yes --> AC[Issue & transmit final release — ACARS]
  end
  subgraph P6["Phase 6: Departure Monitoring & En-Route"]
    AC --> AD[Monitor departure & off-blocks — SITA AMS]
    AD --> AE[Track flight via ACARS position reports]
    AE --> AF{ETA & fuel within\nacceptable tolerance?}
    AF -- No --> AG{Diversion\nrequired?}
    AG -- Yes --> AH[Initiate diversion — NAVBLUE + AMS]
    AH --> AI([End])
    AG -- No --> AE
    AF -- Yes --> AI
  end

  style A fill:#003366,color:#fff,stroke:#003366
  style AI fill:#003366,color:#fff,stroke:#003366
  style D fill:#ff6600,color:#fff,stroke:#ff6600
  style F fill:#ff6600,color:#fff,stroke:#ff6600
  style I fill:#ff6600,color:#fff,stroke:#ff6600
  style L fill:#ff6600,color:#fff,stroke:#ff6600
  style O fill:#ff6600,color:#fff,stroke:#ff6600
  style R fill:#ff6600,color:#fff,stroke:#ff6600
  style V fill:#ff6600,color:#fff,stroke:#ff6600
  style X fill:#ff6600,color:#fff,stroke:#ff6600
  style AB fill:#ff6600,color:#fff,stroke:#ff6600
  style AF fill:#ff6600,color:#fff,stroke:#ff6600
  style AG fill:#ff6600,color:#fff,stroke:#ff6600
